#!/usr/bin/env python3
"""One bounded, memory-only camera measurement; outputs one JSON object."""
import argparse
import fcntl
import json
import math
import os
from pathlib import Path
import signal
import subprocess
import sys

CAMERA = '/dev/v4l/by-id/usb-Chicony_Electronics_Co._Ltd._Integrated_Camera-video-index0'


def run(argv, timeout=3):
    result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    if result.returncode:
        raise RuntimeError(result.stderr.decode(errors='replace').strip()[-300:] or 'Camera command failed')
    return result.stdout


def classify(reading, previous=None, mode='', dark=35, bright=105, margin=8):
    if not all(math.isfinite(x) for x in (reading, dark, bright, margin)):
        raise ValueError('Thresholds and reading must be finite')
    if not (0 <= dark < bright <= 255 and 0 <= margin < (bright-dark)/2):
        raise ValueError('Require 0 <= dark < bright <= 255, with room for hysteresis')
    avg = reading if previous is None or not math.isfinite(previous) else previous * .65 + reading * .35
    if mode == 'high' and avg < dark + margin:
        target = 'high'
    elif mode == 'off' and avg > bright - margin:
        target = 'off'
    elif avg < dark - (margin if mode == 'low' else 0):
        target = 'high'
    elif avg > bright + (margin if mode == 'low' else 0):
        target = 'off'
    else:
        target = 'low'
    return round(avg, 3), target


def capture(camera):
    # Advisory lock serializes our own samplers. A busy check avoids changing
    # controls on a camera already open by a conferencing app.
    lock_path = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp')) / ('keyboard-ambient-' + str(os.getuid()) + '.lock')
    with open(lock_path, 'a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('Another ambient sample is running')
        if not Path(camera).exists():
            raise RuntimeError('Visible-light camera is unavailable')
        busy = subprocess.run(['fuser', camera], capture_output=True, timeout=3)
        if busy.returncode == 0:
            raise RuntimeError('Camera is busy; using schedule fallback')
        if busy.returncode != 1:
            raise RuntimeError('Could not check whether camera is busy')
        def get(name):
            return int(run(['v4l2-ctl', '-d', camera, '--get-ctrl=' + name]).decode().rsplit(':', 1)[1].split()[0])
        def put(name, value):
            run(['v4l2-ctl', '-d', camera, '--set-ctrl=' + name + '=' + str(value)])
        names = ('auto_exposure', 'exposure_time_absolute', 'exposure_dynamic_framerate')
        saved = {name: get(name) for name in names}
        try:
            put('auto_exposure', 1)
            put('exposure_dynamic_framerate', 0)
            put('exposure_time_absolute', 156)  # 15.6ms, fixed between samples
            if get('auto_exposure') != 1 or get('exposure_time_absolute') != 156:
                raise RuntimeError('Camera did not accept fixed exposure')
            data = run(['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error',
                        '-f', 'v4l2', '-input_format', 'yuyv422', '-video_size', '320x240',
                        '-framerate', '30', '-i', camera, '-frames:v', '12',
                        '-vf', 'scale=32:24,format=gray', '-f', 'rawvideo', 'pipe:1'], timeout=8)
            if len(data) != 12 * 768:
                raise RuntimeError('Incomplete camera sample')
            # Discard startup frames, average the final three grayscale frames.
            return sum(data[-2304:]) / 2304
        finally:
            # Run every restoration even if another restoration fails.
            errors = []
            for name in ('exposure_time_absolute', 'exposure_dynamic_framerate', 'auto_exposure'):
                try:
                    put(name, saved[name])
                except Exception as exc:
                    errors.append(str(exc))
            if errors:
                raise RuntimeError('Camera settings restoration failed: ' + '; '.join(errors))


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('--camera', default=CAMERA)
    p.add_argument('--previous', type=float)
    p.add_argument('--mode', choices=['', 'off', 'low', 'high'], default='')
    p.add_argument('--dark', type=float, default=35)
    p.add_argument('--bright', type=float, default=105)
    args = p.parse_args()
    def stop(signum, frame):
        raise RuntimeError('Sample interrupted')
    signal.signal(signal.SIGTERM, stop)
    try:
        classify(0, dark=args.dark, bright=args.bright)  # validate before touching hardware
        reading = capture(args.camera)
        avg, mode = classify(reading, args.previous, args.mode, args.dark, args.bright)
        print(json.dumps(dict(ok=True, reading=round(reading, 3), average=avg, mode=mode)))
    except Exception as exc:
        print(json.dumps(dict(ok=False, error=str(exc))))
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
